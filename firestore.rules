rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOptionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function isOptionalNumber(value) {
      return value == null || value is number;
    }

    function isOptionalBool(value) {
      return value == null || value is bool;
    }

    function isHttpsUrl(value) {
      return value is string
        && value.size() <= 2048
        && value.matches('https://.*');
    }

    function isValidSubmission() {
      return request.resource.data.keys().hasOnly([
          'h_name', 'w_name', 'h_cell', 'h_email', 'w_cell', 'w_email',
          'h_age', 'w_age', 'address', 'years_married', 'issue_presenting',
          'family_rabbi', 'anyone_else_involved', 'submitter_relationship', 'other_notes', 'parents_names', 'num_kids',
          'donation', 'timestamp', 'uid', 'formType'
        ])
        && request.resource.data.keys().hasAll([
          'h_name', 'w_name', 'h_cell', 'h_email', 'w_cell', 'w_email',
          'h_age', 'w_age', 'address', 'years_married', 'issue_presenting',
          'family_rabbi', 'anyone_else_involved', 'submitter_relationship', 'parents_names', 'num_kids',
          'donation', 'timestamp', 'uid', 'formType'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.timestamp is string
        && request.resource.data.timestamp.size() <= 40
        && request.resource.data.formType in ['husband', 'wife', 'both', 'someone-else', 'couple']
        && request.resource.data.donation in ['Yes', 'No']
        && isOptionalString(request.resource.data.h_name, 160)
        && isOptionalString(request.resource.data.w_name, 160)
        && isOptionalString(request.resource.data.h_cell, 80)
        && isOptionalString(request.resource.data.h_email, 254)
        && isOptionalString(request.resource.data.w_cell, 80)
        && isOptionalString(request.resource.data.w_email, 254)
        && isOptionalNumber(request.resource.data.h_age)
        && isOptionalNumber(request.resource.data.w_age)
        && isOptionalString(request.resource.data.address, 500)
        && isOptionalNumber(request.resource.data.years_married)
        && isOptionalString(request.resource.data.issue_presenting, 5000)
        && isOptionalString(request.resource.data.family_rabbi, 240)
        && isOptionalString(request.resource.data.anyone_else_involved, 500)
        && isOptionalString(request.resource.data.submitter_relationship, 160)
        && (
          (request.resource.data.formType == 'someone-else'
            && request.resource.data.submitter_relationship is string
            && request.resource.data.submitter_relationship.size() > 0)
          || (request.resource.data.formType != 'someone-else'
            && request.resource.data.submitter_relationship == null)
        )
        && isOptionalString(request.resource.data.get('other_notes', null), 3000)
        && isOptionalString(request.resource.data.parents_names, 500)
        && isOptionalNumber(request.resource.data.num_kids);
    }

    function isValidContentResource() {
      return request.resource.data.keys().hasOnly([
          'id', 'type', 'source', 'title', 'speaker', 'primaryLabel',
          'primaryUrl', 'imageUrl', 'imageAlt', 'embedUrl', 'dialIn',
          'dialInHref', 'extension', 'schemaVersion', 'published',
          'sortOrder', 'createdAt', 'createdBy'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'type', 'source', 'title', 'speaker', 'primaryLabel',
          'primaryUrl', 'imageUrl', 'imageAlt', 'embedUrl', 'dialIn',
          'dialInHref', 'extension', 'schemaVersion', 'published',
          'sortOrder', 'createdAt', 'createdBy'
        ])
        && request.resource.data.id is string
        && request.resource.data.id.size() <= 160
        && request.resource.data.source in ['youtube', 'torahanytime', 'amazon', 'itorah']
        && (
          (request.resource.data.source == 'amazon' && request.resource.data.type == 'book')
          || (request.resource.data.source != 'amazon' && request.resource.data.type == 'video')
        )
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 240
        && request.resource.data.speaker is string
        && request.resource.data.speaker.size() <= 180
        && request.resource.data.primaryLabel is string
        && request.resource.data.primaryLabel.size() <= 80
        && isHttpsUrl(request.resource.data.primaryUrl)
        && isHttpsUrl(request.resource.data.imageUrl)
        && request.resource.data.imageAlt is string
        && request.resource.data.imageAlt.size() <= 300
        && request.resource.data.embedUrl is string
        && (request.resource.data.embedUrl == '' || isHttpsUrl(request.resource.data.embedUrl))
        && request.resource.data.dialIn is string
        && request.resource.data.dialIn.size() <= 40
        && request.resource.data.dialInHref is string
        && (request.resource.data.dialInHref == '' || request.resource.data.dialInHref.matches('tel:\\+[0-9]+'))
        && request.resource.data.extension is string
        && request.resource.data.extension.size() <= 20
        && request.resource.data.schemaVersion == 1
        && request.resource.data.published == true
        && request.resource.data.sortOrder is int
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
    }

    function isValidEncounter() {
      return request.resource.data.keys().hasOnly([
          'encounterType', 'names', 'contact', 'otherPeopleInvolved', 'occurredDate', 'occurredTime',
          'method', 'notes', 'needsFollowUp', 'submissionId',
          'rootEncounterId', 'previousEncounterId', 'archived',
          'createdAt', 'updatedAt', 'createdBy'
        ])
        && request.resource.data.keys().hasAll([
          'names', 'contact', 'occurredDate', 'occurredTime',
          'method', 'notes', 'needsFollowUp', 'submissionId',
          'rootEncounterId', 'previousEncounterId', 'archived',
          'createdAt', 'updatedAt', 'createdBy'
        ])
        && request.resource.data.names is string
        && request.resource.data.names.size() > 0
        && request.resource.data.names.size() <= 240
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 500
        && isOptionalString(request.resource.data.get('otherPeopleInvolved', null), 500)
        && request.resource.data.occurredDate is string
        && request.resource.data.occurredDate.size() <= 10
        && request.resource.data.get('encounterType', 'completed') in ['completed', 'scheduled']
        && (
          request.resource.data.get('encounterType', 'completed') != 'scheduled'
          || request.resource.data.occurredDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        )
        && request.resource.data.occurredTime is string
        && request.resource.data.occurredTime.size() <= 5
        && request.resource.data.method in ['In person', 'Phone', 'Video', 'Text', 'Email', 'Other']
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 5000
        && request.resource.data.needsFollowUp is bool
        && isOptionalString(request.resource.data.submissionId, 160)
        && request.resource.data.rootEncounterId is string
        && request.resource.data.rootEncounterId.size() > 0
        && request.resource.data.rootEncounterId.size() <= 160
        && isOptionalString(request.resource.data.previousEncounterId, 160)
        && request.resource.data.archived is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.createdBy.size() <= 128;
    }

    function isValidReminderResolution() {
      return request.resource.data.keys().hasOnly(['targetKey', 'resolvedAt', 'resolvedBy'])
        && request.resource.data.keys().hasAll(['targetKey', 'resolvedAt', 'resolvedBy'])
        && request.resource.data.targetKey is string
        && request.resource.data.targetKey.size() > 0
        && request.resource.data.targetKey.size() <= 220
        && request.resource.data.resolvedAt == request.time
        && request.resource.data.resolvedBy == request.auth.uid;
    }

    function isValidManualReminder() {
      return request.resource.data.keys().hasOnly([
          'title', 'description', 'dueDate', 'dueTime', 'completed',
          'createdAt', 'updatedAt', 'createdBy'
        ])
        && request.resource.data.keys().hasAll([
          'title', 'description', 'dueDate', 'dueTime', 'completed',
          'createdAt', 'updatedAt', 'createdBy'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 240
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 3000
        && request.resource.data.dueDate is string
        && request.resource.data.dueDate.size() <= 10
        && (request.resource.data.dueDate == '' || request.resource.data.dueDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && request.resource.data.dueTime is string
        && request.resource.data.dueTime.size() <= 5
        && (request.resource.data.dueTime == '' || request.resource.data.dueTime.matches('[0-9]{2}:[0-9]{2}'))
        && request.resource.data.completed is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.createdBy.size() <= 128;
    }

    function isValidDirectoryEntry() {
      return request.resource.data.keys().hasOnly([
          'name', 'type', 'phone', 'email', 'url', 'notes',
          'createdAt', 'updatedAt', 'createdBy'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'type', 'phone', 'email', 'url', 'notes',
          'createdAt', 'updatedAt', 'createdBy'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 240
        && request.resource.data.type in ['Therapist', 'Person', 'Resource']
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.url is string
        && (request.resource.data.url == '' || isHttpsUrl(request.resource.data.url))
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 3000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.createdBy.size() <= 128;
    }

    function isValidReminderSnooze() {
      return request.resource.data.keys().hasOnly([
          'targetKey', 'snoozedThrough', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.keys().hasAll([
          'targetKey', 'snoozedThrough', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.targetKey is string
        && request.resource.data.targetKey.size() > 0
        && request.resource.data.targetKey.size() <= 220
        && request.resource.data.snoozedThrough is string
        && request.resource.data.snoozedThrough.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function isValidPushSubscription() {
      return request.resource.data.keys().hasOnly([
          'endpoint', 'expirationTime', 'p256dh', 'auth', 'deviceId',
          'timeZone', 'enabled', 'notifyScheduledEncounters', 'notifyNewIntakes',
          'createdAt', 'updatedAt', 'createdBy'
        ])
        && request.resource.data.keys().hasAll([
          'endpoint', 'expirationTime', 'p256dh', 'auth', 'deviceId',
          'timeZone', 'enabled', 'createdAt', 'updatedAt', 'createdBy'
        ])
        && request.resource.data.endpoint is string
        && request.resource.data.endpoint.size() > 0
        && request.resource.data.endpoint.size() <= 2048
        && request.resource.data.endpoint.matches('https://.*')
        && isOptionalNumber(request.resource.data.expirationTime)
        && request.resource.data.p256dh is string
        && request.resource.data.p256dh.size() > 0
        && request.resource.data.p256dh.size() <= 256
        && request.resource.data.auth is string
        && request.resource.data.auth.size() > 0
        && request.resource.data.auth.size() <= 128
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.matches('[a-zA-Z0-9-]{8,64}')
        && request.resource.data.timeZone is string
        && request.resource.data.timeZone.size() > 0
        && request.resource.data.timeZone.size() <= 100
        && request.resource.data.enabled is bool
        && isOptionalBool(request.resource.data.get('notifyScheduledEncounters', null))
        && isOptionalBool(request.resource.data.get('notifyNewIntakes', null))
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.createdBy.size() <= 128;
    }

    function ownsPushSubscriptionId(subscriptionId) {
      return isSignedIn()
        && subscriptionId.matches(request.auth.uid + '_[a-zA-Z0-9-]{8,64}');
    }

    match /content/{contentId} {
      allow read: if true;
      allow create: if isSignedIn() && contentId == request.resource.data.id && isValidContentResource();
      allow delete: if isSignedIn();
      allow update: if false;
    }

    match /artifacts/{appId}/public/data/submissions/{submissionId} {
      allow create: if isSignedIn() && isValidSubmission();
      allow read, update, delete: if isSignedIn();
    }

    match /admin_encounters/{encounterId} {
      allow read, delete: if isSignedIn();
      allow create: if isSignedIn()
        && isValidEncounter()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidEncounter()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.rootEncounterId == resource.data.rootEncounterId
        && request.resource.data.updatedAt == request.time;
    }

    match /admin_reminder_resolutions/{resolutionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidReminderResolution();
      allow delete: if isSignedIn();
    }

    match /admin_manual_reminders/{reminderId} {
      allow read, delete: if isSignedIn();
      allow create: if isSignedIn()
        && isValidManualReminder()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidManualReminder()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time;
    }

    match /admin_reminder_snoozes/{snoozeId} {
      allow read, delete: if isSignedIn();
      allow create, update: if isSignedIn() && isValidReminderSnooze();
    }

    match /admin_push_subscriptions/{subscriptionId} {
      allow read: if ownsPushSubscriptionId(subscriptionId);
      allow create: if ownsPushSubscriptionId(subscriptionId)
        && isValidPushSubscription()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if ownsPushSubscriptionId(subscriptionId)
        && resource.data.createdBy == request.auth.uid
        && isValidPushSubscription()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if ownsPushSubscriptionId(subscriptionId)
        && resource.data.createdBy == request.auth.uid;
    }

    match /admin_directory/{entryId} {
      allow read, delete: if isSignedIn();
      allow create: if isSignedIn()
        && isValidDirectoryEntry()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidDirectoryEntry()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time;
    }

    match /artifacts/{appId}/users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
