{
  "id": "/admin/",
  "name": "Binyan Shalem Admin",
  "short_name": "Binyan Admin",
  "description": "Manage Binyan Shalem resources and intake submissions.",
  "lang": "en-US",
  "start_url": "/admin/",
  "scope": "/admin/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f1f4f2",
  "theme_color": "#3f1f33",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Content library",
      "short_name": "Content",
      "url": "/admin/",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Intake submissions",
      "short_name": "Submissions",
      "url": "/admin/?tab=submissions",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
